generator client {
  provider = "prisma-client-js"
}

// SQLite для локальной разработки. Для продакшена поменяйте provider на
// "postgresql" и DATABASE_URL на строку подключения к Postgres.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Пользователи и авторизация (модели Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  apiTokens  ApiToken[]
  entries    ShelfEntry[]
  booksAdded Book[]       @relation("BookAddedBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Токены для мобильного приложения (Authorization: Bearer ...). В базе хранится только SHA-256.
model ApiToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  name       String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Каталог книг ----------

model Book {
  id             String   @id @default(cuid())
  title          String
  author         String
  year           Int?
  isbn           String?
  coverUrl       String?
  openLibraryKey String?  @unique
  // Нижний регистр "название автор" — для поиска (в т.ч. по кириллице) и дедупликации.
  searchText     String
  createdAt      DateTime @default(now())
  addedById      String?

  addedBy User?        @relation("BookAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  entries ShelfEntry[]

  @@index([searchText])
}

// ---------- Полка пользователя ----------

// status: WANT | READING | PAUSED | READ | DROPPED (см. lib/status.ts)
model ShelfEntry {
  id         String    @id @default(cuid())
  userId     String
  bookId     String
  status     String
  startedAt  DateTime?
  finishedAt DateTime?
  rating     Int? // 1..10
  review     String?
  isPublic   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
}

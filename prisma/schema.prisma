generator client {
  provider = "prisma-client-js"
}

// SQLite для локальной разработки. Для продакшена поменяйте provider на
// "postgresql" и DATABASE_URL на строку подключения к Postgres.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Пользователи и авторизация (модели Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  apiTokens  ApiToken[]
  goals      ReadingGoal[]
  likes      ReviewLike[]
  comments   ReviewComment[]
  notifications Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  devices    DeviceToken[]
  following  Follow[]     @relation("Follower")
  followers  Follow[]     @relation("Following")
  activities Activity[]
  lists      BookList[]
  entries    ShelfEntry[]
  booksAdded Book[]       @relation("BookAddedBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Токены для мобильного приложения (Authorization: Bearer ...). В базе хранится только SHA-256.
model ApiToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  name       String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Каталог книг ----------

model Book {
  id             String   @id @default(cuid())
  title          String
  author         String
  year           Int?
  isbn           String?
  coverUrl       String?
  openLibraryKey String?  @unique
  pageCount      Int?
  // Нижний регистр "название автор" — для поиска (в т.ч. по кириллице) и дедупликации.
  searchText     String
  createdAt      DateTime @default(now())
  addedById      String?

  addedBy    User?          @relation("BookAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  entries    ShelfEntry[]
  activities Activity[]
  listItems  BookListItem[]
  genres     BookGenre[]

  @@index([searchText])
  @@index([isbn])
}

// ---------- Полка пользователя ----------

// status: WANT | READING | PAUSED | READ | DROPPED (см. lib/status.ts)
model ShelfEntry {
  id         String    @id @default(cuid())
  userId     String
  bookId     String
  status     String
  startedAt  DateTime?
  finishedAt DateTime?
  rating     Int? // 1..10
  currentPage Int? // прогресс чтения
  totalPages  Int? // страниц в издании читателя, если отличается от книги
  review     String?
  isPublic   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([userId, bookId])
  @@index([userId, status])
}

// Цель на год: сколько книг пользователь хочет прочитать.
model ReadingGoal {
  userId String
  year   Int
  target Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}

// ---------- Друзья и лента ----------

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// Событие для ленты. type: STATUS (сменил статус) | REVIEW (оценил или написал отзыв).
// Текст отзыва не копируется — лента берёт его из ShelfEntry, только если отзыв публичный.
model Activity {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  type      String
  status    String?
  rating    Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Свои списки ----------

model BookList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BookListItem[]

  @@index([userId])
}

model BookListItem {
  listId  String
  bookId  String
  addedAt DateTime @default(now())

  list BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([listId, bookId])
}

// ---------- Жанры ----------

// Справочник жанров (см. lib/genres.ts). Книге жанры ставятся из тем Open Library или читателями.
model Genre {
  slug  String      @id
  name  String
  books BookGenre[]
}

model BookGenre {
  bookId    String
  genreSlug String
  addedById String?

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreSlug], references: [slug], onDelete: Cascade)

  @@id([bookId, genreSlug])
  @@index([genreSlug])
}

// ---------- Лайки, комментарии, уведомления ----------

model ReviewLike {
  userId    String
  entryId   String
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry ShelfEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
  @@index([entryId])
}

model ReviewComment {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry ShelfEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

// type: FOLLOW | LIKE | COMMENT
model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  type      String
  entryId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Токены устройств для push-уведомлений (APNs).
model DeviceToken {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

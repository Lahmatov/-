# База данных — PostgreSQL. Для разработки: `docker compose -f docker-compose.dev.yml up -d`
DATABASE_URL="postgresql://bookshelf:bookshelf@localhost:5432/bookshelf"
# Пароль базы для docker compose на сервере
POSTGRES_PASSWORD=""

# Redis для ограничения попыток входа (общий для всех серверов). Без него — счётчики в памяти процесса.
REDIS_URL="redis://localhost:6379"

# Секрет для подписи сессий: сгенерируйте командой `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET=""

# Вход через Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Нужно при `npm start` на своём сервере/за прокси (на Vercel выставляется автоматически)
AUTH_TRUST_HOST=true

# iOS-приложение
# Client ID типа iOS из Google Cloud Console (можно несколько через запятую)
AUTH_GOOGLE_IOS_CLIENT_ID=""
# Bundle ID приложения — аудитория токенов Sign in with Apple
APPLE_BUNDLE_ID="com.example.bookshelf"

# Домен для docker compose + Caddy (HTTPS получается автоматически)
DOMAIN="books.example.com"

# Push-уведомления на iPhone (APNs): Apple Developer → Keys → «+» → Apple Push Notifications service.
# APNS_KEY — содержимое .p8 файла (переводы строк можно заменить на \n).
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_KEY=""
APNS_PRODUCTION="false"

# Публичный адрес сайта — для ссылок в письмах (подтверждение email, сброс пароля)
APP_URL="http://localhost:3000"

# Отправка писем: SMTP-URL вида smtp://user:pass@smtp.example.com:587
# Если пусто — при разработке (npm run dev) письма пишутся в лог сервера, в production отправка не работает.
SMTP_URL=""
MAIL_FROM="Книжная полка <no-reply@example.com>"

# Модераторы: email-ы через запятую — им доступна страница /admin/reports
ADMIN_EMAILS=""

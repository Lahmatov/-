# База данных (SQLite-файл для разработки)
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессий: сгенерируйте командой `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET=""

# Вход через Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Нужно при `npm start` на своём сервере/за прокси (на Vercel выставляется автоматически)
AUTH_TRUST_HOST=true
